# .env.example - Copy to .env and fill in your values

# Core Settings
SECRET_KEY=your-super-secret-key-change-this-in-production
APP_NAME=Smart Task API
DEBUG=False
PORT=8000
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Environment: development, staging, production
ENVIRONMENT=development

# Database (SQLite for dev, PostgreSQL for production)
# Development (SQLite - default)
DATABASE_URL=sqlite:///./tasks.db
# Production (PostgreSQL - uncomment for cloud)
# DATABASE_URL=postgresql://username:password@localhost:5432/smarttask

# Storage (Local for dev, S3 for production)
REPORTS_DIR=reports

# S3 Configuration (only needed in production)
# S3_BUCKET_NAME=your-bucket-name
# S3_REGION=us-east-1